<?xml version="1.0"?>
<!--
  gobilda 144mm wheel (see meshes/step, meshes/visual; the older wheel_120
  files are kept there too in case we switch back). Collision stays a plain
  cylinder primitive rather than the full tread mesh.

  Unlike wheel_120 (native axis Z, origin at one face), wheel_144's native
  rotation axis is the STL's local X, spanning -18mm to +34mm - the origin
  is 8mm off the width's centre. wheel_joint spins about Y, so the visual is
  yawed +90 deg about Z (native X -> global Y), then shifted -8mm in Y so
  the mesh ends up centred on the joint like the collision cylinder is.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wheel" params="name x y reflect">
    <link name="${name}">
      <visual>
        <origin xyz="0 -0.008 0" rpy="0 0 ${pi/2}"/>
        <geometry><mesh filename="package://jessica_description/description/meshes/visual/wheel_144.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left_front_wheel"  x="${ wheel_sep_x}" y="${ wheel_sep_y}" reflect="1"/>
  <xacro:wheel name="left_rear_wheel"   x="${-wheel_sep_x}" y="${ wheel_sep_y}" reflect="1"/>
  <xacro:wheel name="right_front_wheel" x="${ wheel_sep_x}" y="${-wheel_sep_y}" reflect="-1"/>
  <xacro:wheel name="right_rear_wheel"  x="${-wheel_sep_x}" y="${-wheel_sep_y}" reflect="-1"/>

</robot>
